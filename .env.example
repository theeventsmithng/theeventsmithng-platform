# Postgres connection strings (Supabase, Neon, RDS, or local).
# On Supabase specifically: DATABASE_URL is the pooled connection (port
# 6543, used by the running app) and DIRECT_URL is the direct connection
# (port 5432, used only for migrations). Get both from Supabase's
# Connect panel → ORM tab. If you're on Neon/RDS/local instead, it's fine
# to set both to the same single connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/theeventsmithng?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/theeventsmithng?schema=public"

# Secret pepper for hashing OTP codes — generate with: openssl rand -hex 32
OTP_HASH_SECRET="replace-with-a-long-random-string"

# Resend API key — free tier covers OTP volume comfortably (3,000/mo, 100/day)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OTP_FROM_EMAIL="The EventSmith NG <login@theeventsmithng.com>"

# Object storage (S3-compatible) for documents/quotes/moodboards
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT="" # leave blank for real AWS S3; set to your R2 endpoint if using Cloudflare R2
